# Copie para .env no seu computador. Nunca commite o arquivo .env.
# Nunca coloque senhas reais neste exemplo.

FLASK_ENV=development
DEBUG=true
SECRET_KEY=troque-esta-chave-local

# Desenvolvimento local (padrão): SQLite
# DATABASE_URL=sqlite:///instance/financeiro.db

# Produção (exemplo — preencha no servidor, não aqui):
# FLASK_ENV=production
# DEBUG=false
# SECRET_KEY=
# DATABASE_URL=postgresql://usuario:senha@host:5432/finup
# SERVER_URL=https://meusistema.com.br
# SESSION_COOKIE_SECURE=true
# PREFERRED_URL_SCHEME=https
# ADMIN_SENHA=
# ADMIN_ACESSA_TUDO=false
# STORAGE_BACKEND=local
# UPLOAD_FOLDER=
# BACKUP_FOLDER=
# PORT=5000
